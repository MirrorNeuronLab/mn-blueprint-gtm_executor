{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/ui.schema.json",
  "web_ui": {
    "enabled": true,
    "adapter": "static_html",
    "kind": "output",
    "title": "Campaign execution report",
    "description": "Inspect the latest saved cycle, delivery receipts and pending approvals in aggregate."
  },
  "starter_questions": [
    "What must I review before an email is sent?",
    "Where do I add contacts and the AgentMail key?",
    "What happens if a send cannot be confirmed?"
  ],
  "init_config_review": {
    "required": true,
    "fields": [
      {
        "path": "inputs.payload.website_url",
        "label": "Website",
        "type": "text",
        "required": true,
        "default": "https://bibblio.app"
      },
      {
        "path": "inputs.payload.goal_id",
        "label": "Shared goal",
        "type": "text",
        "required": true,
        "default": "bibblio-marketing"
      },
      {
        "path": "inputs.payload.peer_job_id",
        "label": "Previous pair peer",
        "type": "text",
        "required": false
      },
      {
        "path": "inputs.payload.instruction",
        "label": "Marketing instructions",
        "type": "textarea",
        "required": false
      },
      {
        "path": "inputs.payload.contacts_file",
        "label": "Contacts CSV",
        "type": "local_path",
        "path_kind": "file",
        "required": true
      },
      {
        "path": "inputs.payload.inbox_id",
        "label": "AgentMail inbox",
        "type": "text",
        "required": true
      },
      {
        "path": "credentials.agentmail_api_key",
        "label": "AgentMail API key",
        "type": "password",
        "secret": true,
        "environment_variable": "AGENTMAIL_API_KEY",
        "required": true
      },
      {
        "path": "inputs.payload.newsletter_eligible",
        "label": "Confirmed newsletter recipients",
        "type": "checkbox",
        "default": false,
        "required": false,
        "description": "Enable only after confirming the imported list subscribed to marketing."
      },
      {
        "path": "inputs.payload.common_goal",
        "label": "Common goal",
        "type": "textarea",
        "required": false,
        "default": "Market Bibblio through relevant, human-approved email outreach."
      },
      {
        "path": "inputs.payload.collaboration_group_id",
        "label": "Collaboration group",
        "type": "text",
        "required": false
      },
      {
        "path": "inputs.payload.collaboration_peers",
        "label": "Group members",
        "type": "textarea",
        "value_type": "array",
        "required": false,
        "default": []
      }
    ]
  },
  "setup_guide": {
    "schema": "otterdesk.setup_guide.v1",
    "introduction": "I can explain what an email review looks like before you connect an inbox. To draft for your own campaign, select the contacts file and enter the inbox details in their dedicated fields. You review the exact email before sending.",
    "sample": {
      "available": false
    },
    "real": {
      "introduction": "Review your marketing settings and connect co-workers in Collaboration.",
      "values": {}
    },
    "fields": [
      {
        "path": "inputs.payload.website_url",
        "label": "Website",
        "type": "text",
        "required": true,
        "default": "https://bibblio.app"
      },
      {
        "path": "inputs.payload.goal_id",
        "label": "Shared goal",
        "type": "text",
        "required": true,
        "default": "bibblio-marketing"
      },
      {
        "path": "inputs.payload.peer_job_id",
        "label": "Previous pair peer",
        "type": "text",
        "required": false
      },
      {
        "path": "inputs.payload.instruction",
        "label": "Marketing instructions",
        "type": "textarea",
        "required": false
      },
      {
        "path": "inputs.payload.contacts_file",
        "label": "Contacts CSV",
        "type": "local_path",
        "path_kind": "file",
        "required": true
      },
      {
        "path": "inputs.payload.inbox_id",
        "label": "AgentMail inbox",
        "type": "text",
        "required": true
      },
      {
        "path": "credentials.agentmail_api_key",
        "label": "AgentMail API key",
        "type": "password",
        "secret": true,
        "environment_variable": "AGENTMAIL_API_KEY",
        "required": true
      },
      {
        "path": "inputs.payload.newsletter_eligible",
        "label": "Confirmed newsletter recipients",
        "type": "checkbox",
        "default": false,
        "required": false,
        "description": "Enable only after confirming the imported list subscribed to marketing."
      },
      {
        "path": "inputs.payload.common_goal",
        "label": "Common goal",
        "type": "textarea",
        "required": false,
        "default": "Market Bibblio through relevant, human-approved email outreach."
      },
      {
        "path": "inputs.payload.collaboration_group_id",
        "label": "Collaboration group",
        "type": "text",
        "required": false
      },
      {
        "path": "inputs.payload.collaboration_peers",
        "label": "Group members",
        "type": "textarea",
        "value_type": "array",
        "required": false,
        "default": []
      }
    ],
    "prompt_file": "@/payloads/prompts/setup.md",
    "run_guidance": {
      "on_start": "I’ll check for approved campaign ideas and incoming replies. When a draft needs your decision, you can review its exact copy and recipients.",
      "output_ready": "Open the saved marketing status to check which drafts still need a decision.",
      "web_ui_ready": "Open the execution report and check pending approvals or recipient outcomes that need review."
    }
  }
}
